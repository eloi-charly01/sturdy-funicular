{% extends 'base.html.twig' %}

{% block title %}
	{{ parent() }}
	Tableau de bord
{% endblock %}

{% block body %}
	<div>
		<div class="mb-6">
			<h4 class="text-2xl font-semibold text-ink">Tableau de bord</h4>
			<p class="mt-1 text-sm text-ink-muted">Vue d'ensemble de votre activité</p>
		</div>

		<div class="grid grid-cols-1 gap-4 md:grid-cols-3">
			{{ include('components/widget.html.twig', { title: 'Projets', description: 'Nombre total de projets', total: count_projects, icon: 'fas fa-folder-open', variant: 'primary' }) }}
			{{ include('components/widget.html.twig', { title: 'Membres', description: 'Nombre total des membres', total: count_users, icon: 'fas fa-users', variant: 'success' }) }}
			{{ include('components/widget.html.twig', { title: 'Taches', description: 'Nombre total des taches', total: count_task, icon: 'fas fa-check-square', variant: 'danger' }) }}
		</div>

		{% set card_body %}
			<div class="overflow-x-auto">
				<table class="min-w-full divide-y divide-border text-sm text-left">
					<thead class="bg-surface-muted text-ink-muted uppercase text-xs">
						<tr>
							<th class="px-6 py-3 font-medium">Projet</th>
							<th class="px-6 py-3 font-medium">Nombre de tâches</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-border">
						{% for item in tasks_per_project %}
							<tr class="transition hover:bg-surface-active">
								<td class="px-6 py-4 font-medium text-ink">{{ item.name }}</td>
								<td class="px-6 py-4 text-ink-muted">{{ item.count }}</td>
							</tr>
						{% else %}
							<tr>
								<td colspan="2">
									{% include 'components/empty_state.html.twig' with {
										icon: 'fas fa-folder-open',
										title: 'Aucun projet',
										message: 'Commencez par créer votre premier projet.',
									} %}
								</td>
							</tr>
						{% endfor %}
					</tbody>
				</table>
			</div>
		{% endset %}

		<div class="mt-8">
			{{ include('components/card.html.twig', {
				title: 'Tâches par projet',
				body: card_body,
			}) }}
		</div>
	</div>
{% endblock %}
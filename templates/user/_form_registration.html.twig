{% set field_classes = 'block w-full rounded-md border border-border bg-surface px-3.5 py-2 text-sm text-ink placeholder:text-ink-faint focus:outline-none focus:ring-2 focus:ring-focus-ring' %}
{% set label_classes = 'block text-sm font-medium text-ink mb-1.5' %}

{{ form_start(registrationForm, { 'attr': { 'enctype': 'multipart/form-data', 'class': 'space-y-5' } }) }}

{% if registrationForm.vars.errors|length > 0 %}
	<div class="mb-4 flex rounded-md bg-danger/10 p-4">
		<div class="flex-shrink-0">
			<i class="fas fa-exclamation-circle text-danger"></i>
		</div>
		<div class="ml-3 text-danger">
			{{ form_errors(registrationForm) }}
		</div>
	</div>
{% endif %}

<div>
	{{ form_label(registrationForm.imageFile, 'Inserer l\'image', {'label_attr': {'class': label_classes}}) }}
	<div class="mt-1">
		{{ form_widget(registrationForm.imageFile, {'attr': {'class': field_classes}}) }}
	</div>
</div>

<div>
	{{ form_label(registrationForm.firstname, 'Nom du membre', {'label_attr': {'class': label_classes}}) }}
	<div class="mt-1">
		{{ form_widget(registrationForm.firstname, {'attr': {'class': field_classes, 'placeholder': 'nom ...'}}) }}
	</div>
</div>
<div>
	{{ form_label(registrationForm.lastname, 'Prénom du membre', {'label_attr': {'class': label_classes}}) }}
	<div class="mt-1">
		{{ form_widget(registrationForm.lastname, {'attr': {'class': field_classes, 'placeholder': 'Prénom ...'}}) }}
	</div>
</div>

<div>
	{{ form_label(registrationForm.phone, 'Numero telephone du membre', {'label_attr': {'class': label_classes}}) }}
	<div class="mt-1">
		{{ form_widget(registrationForm.phone, {'attr': {'class': field_classes, 'placeholder': 'Numéro ...'}}) }}
	</div>
</div>

<div>
	{{ form_label(registrationForm.email, 'Email professionnel', {'label_attr': {'class': label_classes}}) }}
	<div class="mt-1">
		{{ form_widget(registrationForm.email, {'attr': {'class': field_classes, 'placeholder': 'votre@email.com'}}) }}
	</div>
</div>

<div>
	{{ form_label(registrationForm.plainPassword, 'Mot de passe', {'label_attr': {'class': label_classes}}) }}
	<div class="mt-1">
		{{ form_widget(registrationForm.plainPassword, {'attr': {'class': field_classes, 'placeholder': '••••••••'}}) }}
	</div>
	<p class="mt-2 text-xs text-ink-muted">Minimum 8 caractères</p>
</div>

{{ include('components/button.html.twig', {
	type: 'submit',
	icon: 'fas fa-user-plus',
	label: "S'inscrire",
	extra_classes: 'w-full justify-center',
}) }}

{{ form_end(registrationForm) }}
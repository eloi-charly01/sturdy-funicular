{% extends 'base.html.twig' %}

{% block title %}
	{{ parent() }}
	Gestion des Membres
{% endblock %}

{% block body %}
	<div class="overflow-hidden">
		<div class="mb-6 flex items-center justify-between">
			<div>
				<h4 class="text-2xl font-semibold text-ink">Gestion des membres</h4>
				<p class="mt-1 text-sm text-ink-muted">Les membres de votre équipe</p>
			</div>

			{{ include('components/button.html.twig', {
				href: path('app_user.register'),
				icon: 'fas fa-user-plus',
				label: 'Nouveau membre',
			}) }}
		</div>

		<div class="px-6 py-4">
			{% if users|length > 0 %}
				<div class="grid w-full grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3">
					{% for user in users %}
						<div class="overflow-hidden rounded-lg border border-border bg-surface shadow-sm">
							<div class="border-b border-border pb-6 text-center">
								<div class="mb-3 flex justify-center pt-8">
									{% if user.photo %}
										<img class="h-20 w-20 cursor-pointer rounded-full object-cover" src="{{ asset('uploads/users/' ~ user.photo) }}" alt="Photo de {{ user.firstname }}">
									{% else %}
										<div class="flex h-20 w-20 items-center justify-center rounded-full bg-brand-600 text-xl font-bold text-white">
											{{ user.firstname|first|upper }}{{ user.lastname|first|upper }}
										</div>
									{% endif %}
								</div>
								<h4 class="text-md font-semibold text-ink">
									{{ user.firstname }}<br>{{ user.lastname }}
								</h4>
								<div class="my-2 text-center text-sm text-ink-muted">
									<i class="fas fa-envelope mr-1.5"></i>
									{{ user.email }}
								</div>
								{% if user.phone %}
									<div class="text-center text-sm text-ink-muted">
										<i class="fas fa-phone mr-1.5"></i>
										{{ user.phone }}
									</div>
								{% endif %}
							</div>
							<div class="mt-4 flex justify-center gap-2 pb-6">
								<span class="rounded-md bg-surface-active px-3 py-2 text-ink-muted">
									<i class="fas fa-envelope"></i>
								</span>
								<span class="rounded-md bg-surface-active px-4 py-2 text-ink-muted">
									<i class="fas fa-phone"></i>
								</span>
							</div>
						</div>
					{% endfor %}
				</div>
			{% else %}
				{% include 'components/empty_state.html.twig' with {
					icon: 'fas fa-users',
					title: 'Aucun membre',
					message: 'Invitez votre premier membre pour constituer votre équipe.',
				} %}
			{% endif %}
			{{ include ("partials/_pagination.html.twig", { pager : users })}}
		</div>
	</div>
{% endblock %}
{% extends 'base.html.twig' %}

{% block title %}
	{{ parent() }}
	Nouveau membre
{% endblock %}

{% block body %}
	<div class="overflow-hidden">
		<div class="mb-6 flex items-center justify-between">
			<div>
				<h4 class="text-2xl font-semibold text-ink">Créer un nouveau membre</h4>
				<p class="mt-1 text-sm text-ink-muted">Ajoutez un membre à votre équipe</p>
			</div>
			{{ include('components/button.html.twig', {
				href: path('app_user.index'),
				variant: 'secondary',
				icon: 'fas fa-arrow-left',
				label: 'Retour à la liste',
			}) }}
		</div>
		<div class="overflow-hidden rounded-lg border border-border bg-surface shadow-sm">
			{% set form_body %}
				{{ include('user/_form_registration.html.twig') }}
			{% endset %}
			{{ include('components/card.html.twig', { body: form_body }) }}
		</div>
	</div>
{% endblock %}
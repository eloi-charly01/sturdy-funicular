{% extends 'base.html.twig' %}

{% block title %} Gestion de tickets {% endblock %}

{% block body %}
<div class="overflow-hidden">

    <div class="mb-6 flex justify-between items-center">
        <h4 class="text-2xl font-semibold text-gray-700">Gestion des tickets</h4>

        <a href="{{ path('app_task.new') }}"
           class="inline-flex items-center px-4 py-2 bg-indigo-600 text-xs text-white uppercase hover:bg-indigo-700">
            <i class="fas fa-plus mr-2"></i>
            Nouveau ticket
        </a>
    </div>

    <div class="overflow-x-auto">
        <div class="flex w-full space-x-4 p-6 max-h-screen">

            {# Boucle sur les statuts #}
            {% for status in statuses %}
                <div class="flex-1 bg-gray-100 rounded-lg p-4 flex flex-col"
                     data-status="{{ status.value }}">
                     
                    {# Header colonne #}
                    <div class="flex justify-between items-center mb-4">
                        <h3 class="text-sm font-semibold text-gray-700 uppercase">
                            {{ status.label() }}
                        </h3>

                        {% set count = tasks|filter(task => task.status.value == status.value)|length %}
                        <span class="text-xs bg-gray-300 px-2 py-1 rounded-full">{{ count }}</span>
                    </div>

                    {# Cards container (Sortable) #}
                    <div class="space-y-4 task-column" data-status="{{ status.value }}">
                        {% for task in tasks %}
                            {% if task.status.value == status.value %}
                                <div class="bg-white rounded-lg shadow p-4 hover:shadow-md transition task-card"
                                     data-task-id="{{ task.id }}">

                                    <div class="flex justify-between items-center mb-2">
                                        <div class="font-semibold text-gray-800">
                                            {{ task.title }}
                                        </div>
                                        <span class="px-2 py-1 text-xs rounded-full {{ status.colorClass() }}">
                                            {{ status.label() }}
                                        </span>
                                    </div>

                                    <div class="text-xs text-gray-500 mb-1">
                                        Projet : {{ task.project.acronyme }}
                                    </div>

                                    <div class="text-xs text-gray-500 mb-1">
                                        Assigné : {{ task.assigned.firstname }}
                                    </div>

                                    <div class="text-xs text-gray-500 mb-3">
                                        Deadline : {{ task.finishedAt ? task.finishedAt|date('Y/m/d') : 'N/A' }}
                                    </div>

                                    <div class="flex space-x-3 mt-3 text-sm">
                                        <a href="{{ path('app_task.show', {'id': task.id}) }}" class="text-indigo-600">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <a href="{{ path('app_task.edit', {'id': task.id}) }}" class="text-yellow-600">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        {% include "task/_delete_form.html.twig" %}
                                    </div>

                                </div>
                            {% endif %}
                        {% endfor %}

                        {% if tasks|filter(task => task.status.value == status.value)|length == 0 %}
                            <p class="text-sm text-gray-400 text-center">Aucune tâche</p>
                        {% endif %}
                    </div>

                </div>
            {% endfor %}

        </div>
    </div>

</div>
{% endblock %}
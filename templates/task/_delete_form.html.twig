<form method="post" action="{{ path('app_task.delete', {'id': task.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce ticket ?');">
	<input type="hidden" name="_token" value="{{ csrf_token('delete' ~ task.id) }}">
	<button type="submit" class="text-danger hover:text-danger/70" title="Supprimer">
		<i class="fas fa-trash"></i>
	</button>
</form>
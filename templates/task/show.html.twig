{% extends 'base.html.twig' %}

{% block title %}
	{{ parent() }}
	- Détail du ticket
{% endblock %}

{% block body %}
	<div class="overflow-hidden">
		<div class="mb-6 flex justify-between items-center">
			<h4 class="text-2xl font-semibold text-gray-700">Détail du ticket</h4>
		</div>

		<div
			class="bg-white px-6 py-6 rounded-lg shadow-sm border border-gray-200 space-y-10 mb-6">

			{# ✅ Infos ticket divisées en 2 colonnes #}
			<div
				class="grid grid-cols-1 lg:grid-cols-2 gap-8 text-sm text-gray-700">

				{# Colonne gauche #}
				<div class="space-y-4">
					<div>
						<p class="text-gray-500 font-medium mb-1">Titre</p>
						<p class="text-base font-semibold text-gray-900">{{ task.title }}</p>
					</div>

					<div>
						<p class="text-gray-500 font-medium mb-1">Statut</p>
						<span class="inline-block px-2 py-1 text-xs font-semibold rounded-full {{ task.status.colorClass }}">
							{{ task.status.label }}
						</span>
					</div>

					<div>
						<p class="text-gray-500 font-medium mb-1">Projet</p>
						<p class="font-semibold">{{ task.project.name ?? '-' }}</p>
					</div>

					<div>
						<p class="text-gray-500 font-medium mb-1">Assigné à</p>
						<p>{{ task.assigned.firstname ?? '-' }}</p>
					</div>
				</div>

				{# Colonne droite #}
				<div class="space-y-4">
					<div>
						<p class="text-gray-500 font-medium mb-1">Description</p>
						<p class="text-gray-700 whitespace-pre-line">{{ task.description }}</p>
					</div>

					<div>
						<p class="text-gray-500 font-medium mb-1">Créé le</p>
						<p>{{ task.createdAt ? task.createdAt|date('d/m/Y H:i') : '-' }}</p>
					</div>

					<div>
						<p class="text-gray-500 font-medium mb-1">Commencé le</p>
						<p>{{ task.startedAt ? task.startedAt|date('d/m/Y H:i') : '-' }}</p>
					</div>

					<div>
						<p class="text-gray-500 font-medium mb-1">Terminé le</p>
						<p>{{ task.finishedAt ? task.finishedAt|date('d/m/Y H:i') : '-' }}</p>
					</div>
				</div>
			</div>

			{# ✅ Commentaire - Formulaire #}
			<div>
				<h5 class="text-lg font-semibold text-gray-800 mb-4">Ajouter un commentaire</h5>
				<form method="post">
					<div class="mb-4">
						<label for="comment_content" class="block text-sm font-medium text-gray-700 mb-1">Votre commentaire</label>
						<textarea id="comment_content" name="content" rows="4" class="block w-full px-4 py-2 text-sm text-gray-700 bg-white border border-gray-200 rounded-md" placeholder="Saisissez votre commentaire ici..."></textarea>
					</div>

					<div class="flex justify-end">
						<button type="submit" class="inline-flex items-center px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white rounded-sm text-sm font-medium">
							💬 Ajouter
						</button>
					</div>
				</form>
			</div>

			{# ✅ Liste des commentaires #}
			<div>
				<h5 class="text-lg font-semibold text-gray-800 mb-4">Commentaires</h5>
				<div
					class="space-y-4">
					{#
														{% for comment in task.comments %}
															<div class="bg-gray-50 px-4 py-3 rounded-md border text-sm text-gray-800">
																<strong>{{ comment.author }}</strong>
																<em class="text-xs text-gray-500">({{ comment.createdAt|date('d/m/Y H:i') }})</em><br>
																{{ comment.content }}
															</div>
														{% else %}
															<p class="text-sm text-gray-500 italic">Aucun commentaire pour le moment.</p>
														{% endfor %}
														#}
					<p class="text-sm text-gray-500 italic">Aucun commentaire pour le moment.</p>
				</div>
			</div>
		</div>

		{# ✅ Actions #}
		<div class="flex justify-between items-center">
			<div class="flex gap-3">
				<a href="{{ path('app_task.index') }}" class="inline-flex items-center px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-800 rounded-sm text-sm font-medium">
					← Retour à la liste
				</a>

				<a href="{{ path('app_task.edit', {'id': task.id}) }}" class="inline-flex items-center px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white rounded-sm text-sm font-medium">
					✏️ Modifier
				</a>
			</div>

			{{ include('task/_delete_form.html.twig') }}
		</div>
	</div>
{% endblock %}

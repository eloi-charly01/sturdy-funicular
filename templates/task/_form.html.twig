{% set field_classes = 'block w-full rounded-md border border-border bg-surface px-3.5 py-2 text-sm text-ink placeholder:text-ink-faint focus:outline-none focus:ring-2 focus:ring-focus-ring' %}
{% set label_classes = 'block text-sm font-medium text-ink mb-1.5' %}

{{ form_start(form, {'attr': {'class': 'space-y-6'}}) }}

<div>
	{{ form_label(form.title, 'Nom taches', {'label_attr': {'class': label_classes}}) }}
	{{ form_widget(form.title, {'attr': {'class': field_classes, 'placeholder': 'Ex: Fix bugs'}}) }}
	{{ form_errors(form.title) }}
</div>

<div>
	{{ form_label(form.description, 'Description', {'label_attr': {'class': label_classes}}) }}
	{{ form_widget(form.description, {'attr': {'class': field_classes, 'placeholder': 'Ex: Description détaillée du ticket', 'rows': 4}}) }}
	{{ form_errors(form.description) }}
</div>

<div>
	{{ form_label(form.finishedAt, 'Deadline', {'label_attr': {'class': label_classes}}) }}
	{{ form_widget(form.finishedAt, {'attr': {'class': field_classes}}) }}
	{{ form_errors(form.finishedAt) }}
</div>

<div>
	{{ form_label(form.status, 'Status', {'label_attr': {'class': label_classes}}) }}
	{{ form_widget(form.status, {'attr': {'class': field_classes}}) }}
	{{ form_errors(form.status) }}
</div>

<div>
	{{ form_label(form.project, 'Projet', {'label_attr': {'class': label_classes}}) }}
	{{ form_widget(form.project, {'attr': {'class': field_classes}}) }}
	{{ form_errors(form.project) }}
</div>

<div>
	{{ form_label(form.assigned, 'Assigné à', {'label_attr': {'class': label_classes}}) }}
	{{ form_widget(form.assigned, {'attr': {'class': field_classes}}) }}
	{{ form_errors(form.assigned) }}
</div>

<div class="flex justify-end space-x-3 border-t border-border pt-4">
	{{ include('components/button.html.twig', {
		type: 'submit',
		icon: 'fas fa-save',
		label: button_label|default('Enregistrer'),
	}) }}
</div>

{{ form_end(form) }}
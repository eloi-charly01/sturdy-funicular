{{ form_start(form, {'attr': {'class': 'space-y-6'}}) }}

{# Champ Nom du projet #}
<div>
	{{ form_label(form.title, 'Nom taches', {
            'label_attr': {
                'class': 'block text-sm font-medium text-gray-700 mb-1'
            }
        }) }}
	{{ form_widget(form.title, {
            'attr': {
                'class': 'block w-full px-4 py-2 text-sm text-gray-700 bg-white border border-gray-200 rounded-md focus:border-indigo-500 focus:ring-indigo-500',
                'placeholder': 'Ex: Fix bugs '
            }
        }) }}
	{{ form_errors(form.title) }}
</div>

<div>
	{{ form_label(form.description, 'Descritipon de ', {
            'label_attr': {
                'class': 'block text-sm font-medium text-gray-700 mb-1'
            }
        }) }}
	{{ form_widget(form.description, {
            'attr': {
                'class': 'block w-full px-4 py-2 text-sm text-gray-700 bg-white border border-gray-200 rounded-md focus:border-indigo-500 focus:ring-indigo-500',
                'placeholder': 'Ex: Déscription detaillé u ticket',
                'rows': 4
            }
        }) }}
	{{ form_errors(form.description) }}
</div>

<div>
	{{ form_label(form.status, 'status', {
            'label_attr': {
                'class': 'block text-sm font-medium text-gray-700 mb-1'
            }
        }) }}
	{{ form_widget(form.status, {
            'attr': {
                'class': 'block w-full px-4 py-2 text-sm text-gray-700 bg-white border border-gray-200 rounded-md focus:border-indigo-500 focus:ring-indigo-500',
                'placeholder': 'Status du projets',
                
            }
        }) }}
	{{ form_errors(form.status) }}
</div>


{# Champ Statut #}
<div>
	{{ form_label(form.project, 'Projet', {
            'label_attr': {
                'class': 'block text-sm font-medium text-gray-700 mb-1'
            }
        }) }}
	{{ form_widget(form.project, {
            'attr': {
                'class': 'block w-full px-4 py-2 text-sm text-gray-700 bg-white border border-gray-200 rounded-md focus:border-indigo-500 focus:ring-indigo-500'
            }
        }) }}
	{{ form_errors(form.project) }}
</div>

{# Champ Statut #}
<div>
	{{ form_label(form.assigned, 'Assigné à', {
            'label_attr': {
                'class': 'block text-sm font-medium text-gray-700 mb-1'
            }
        }) }}
	{{ form_widget(form.assigned, {
            'attr': {
                'class': 'block w-full px-4 py-2 text-sm text-gray-700 bg-white border border-gray-200 rounded-md focus:border-indigo-500 focus:ring-indigo-500'

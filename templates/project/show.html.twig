{% extends 'base.html.twig' %}

{% block title %}Détails du projet -
	{{ project.name }}
{% endblock %}

{% block body %}
	<div class="overflow-hidden">
		<div class="mb-6 flex items-center justify-between">
			<div>
				<h4 class="text-2xl font-semibold text-ink">Détails du projet</h4>
				<p class="mt-1 text-sm text-ink-muted">{{ project.name }}</p>
			</div>
			<div class="flex space-x-2">
				{{ include('components/button.html.twig', {
					href: path('app_project.edit', {'id': project.id}),
					variant: 'secondary',
					icon: 'fas fa-edit',
					label: 'Modifier',
				}) }}
				{{ include('components/button.html.twig', {
					href: path('app_project.index'),
					variant: 'secondary',
					icon: 'fas fa-arrow-left',
					label: 'Retour',
				}) }}
			</div>
		</div>

		<div class="overflow-hidden rounded-lg border border-border bg-surface shadow-sm">
			<div class="border-b border-border bg-surface-muted px-6 py-4">
				<div class="flex items-center justify-between">
					<div>
						<h2 class="flex items-center text-xl font-bold text-ink">
							<span class="mr-3 rounded-full px-3 py-1 font-mono text-sm {{ project.status.colorClass }}">
								{{ project.acronyme }}
							</span>
							{{ project.name }}
						</h2>
						<p class="mt-1 text-sm text-ink-muted">Créé le
							{{ project.createdAt|date('d/m/Y') }}</p>
					</div>
					<span class="rounded-full px-3 py-1 text-xs font-semibold {{ project.status.colorClass }}">
						{{ project.status.label }}
					</span>
				</div>
			</div>

			<div class="px-6 py-4">
				<div class="mb-6">
					<h3 class="mb-2 text-lg font-medium text-ink">Description</h3>
					<div class="max-w-none text-ink-muted">{{ project.description|nl2br }}</div>
				</div>

				<div class="grid grid-cols-1 gap-6 md:grid-cols-2">
					<div class="rounded-lg border border-border p-4">
						<h4 class="mb-3 text-sm font-medium text-ink-muted">INFORMATIONS</h4>
						<dl class="space-y-3">
							<div class="flex items-start">
								<dt class="w-32 text-sm font-medium text-ink-muted">Créé par</dt>
								<dd class="text-sm text-ink">{{ project.creator.username ?? 'Non spécifié' }}</dd>
							</div>
							<div class="flex items-start">
								<dt class="w-32 text-sm font-medium text-ink-muted">Date création</dt>
								<dd class="text-sm text-ink">{{ project.createdAt|date('d/m/Y H:i') }}</dd>
							</div>
							<div class="flex items-start">
								<dt class="w-32 text-sm font-medium text-ink-muted">Dernière modification</dt>
								<dd class="text-sm text-ink">{{ project.updatedAt|date('d/m/Y H:i') }}</dd>
							</div>
						</dl>
					</div>

					<div class="rounded-lg border border-border p-4">
						<h4 class="mb-3 text-sm font-medium text-ink-muted">ÉQUIPE</h4>
						<p class="text-sm text-ink">Aucun collaborateur assigné</p>
					</div>
				</div>
			</div>

			<div class="border-t border-border px-6 py-4">
				<h3 class="mb-4 text-lg font-medium text-ink">Tâches associées</h3>
				<p class="text-sm text-ink-muted">Aucune tâche associée à ce projet</p>
			</div>
		</div>
	</div>
{% endblock %}
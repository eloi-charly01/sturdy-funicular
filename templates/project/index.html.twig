{% extends 'base.html.twig' %}

{% block title %}Gestion des Projets
{% endblock %}

{% block body %}
	<div class="overflow-hidden">
		<div class="mb-6 flex items-center justify-between">
			<div>
				<h4 class="text-2xl font-semibold text-ink">Gestion des projets</h4>
				<p class="mt-1 text-sm text-ink-muted">Suivez l'avancement de vos projets</p>
			</div>

			{{ include('components/button.html.twig', {
				href: path('app_project.new'),
				icon: 'fas fa-plus',
				label: 'Nouveau projet',
			}) }}
		</div>

		<div class="overflow-hidden rounded-lg border border-border bg-surface shadow-sm">
			{% set table_body %}
				<div class="overflow-x-auto w-full max-w-full">
					<table class="min-w-full divide-y divide-border">
						<thead class="bg-surface-muted">
							<tr>
								<th scope="col" class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-ink-muted">Acronyme</th>
								<th scope="col" class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-ink-muted">Nom</th>
								<th scope="col" class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-ink-muted">Statut</th>
								<th scope="col" class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-ink-muted">Créé le</th>
								<th scope="col" class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-ink-muted">Actions</th>
							</tr>
						</thead>
						<tbody class="divide-y divide-border bg-surface">
							{% for project in projects %}
								<tr class="transition hover:bg-surface-active">
									<td class="whitespace-nowrap px-6 py-4">
										<span class="inline-flex rounded-full px-2 text-xs leading-5 font-semibold {{ project.status.colorClass }}">
											{{ project.acronyme }}
										</span>
									</td>
									<td class="px-6 py-4">
										<div class="text-sm font-medium text-ink">{{ project.name }}</div>
										<div class="line-clamp-1 text-sm text-ink-muted">{{ project.description }}</div>
									</td>
									<td class="whitespace-nowrap px-6 py-4">
										<span class="inline-flex rounded-full px-2 text-xs leading-5 font-semibold {{ project.status.colorClass }}">
											{{ project.status.label }}
										</span>
									</td>
									<td class="whitespace-nowrap px-6 py-4 text-sm text-ink-muted">
										{{ project.createdAt|date('d/m/Y') }}
									</td>
									<td class="whitespace-nowrap px-6 py-4 text-sm font-medium">
										<div class="flex items-center space-x-3">
											<a href="{{ path('app_project.show', {'id': project.id}) }}" class="text-brand-600 hover:text-brand-700" title="Voir">
												<i class="fas fa-eye"></i>
											</a>
											<a href="{{ path('app_project.edit', {'id': project.id}) }}" class="text-ink-muted hover:text-ink" title="Modifier">
												<i class="fas fa-edit"></i>
											</a>
											{% include "project/_delete_form.html.twig" %}
										</div>
									</td>
								</tr>
							{% else %}
								<tr>
									<td colspan="5">
										{% include 'components/empty_state.html.twig' with {
											icon: 'fas fa-folder-open',
											title: 'Aucun projet trouvé',
											message: 'Créez votre premier projet pour démarrer.',
										} %}
									</td>
								</tr>
							{% endfor %}
						</tbody>
					</table>
				</div>
				{{ include ("partials/_pagination.html.twig", { pager : projects })}}
			{% endset %}

			{{ include('components/card.html.twig', { body: table_body }) }}
		</div>
	</div>
{% endblock %}
{{ form_start(form, {'attr': {'class': 'space-y-6'}}) }}

{# Champ Nom du projet #}
<div>
	{{ form_label(form.name, 'Nom du projet', {
            'label_attr': {
                'class': 'block text-sm font-medium text-gray-700 mb-1'
            }
        }) }}
	{{ form_widget(form.name, {
            'attr': {
                'class': 'block w-full px-4 py-2 text-sm text-gray-700 bg-white border border-gray-200 rounded-md focus:border-indigo-500 focus:ring-indigo-500',
                'placeholder': 'Ex: Projet Marketing 2023'
            }
        }) }}
	{{ form_errors(form.name) }}
</div>

{# Champ Acronyme #}
<div>
	{{ form_label(form.acronyme, 'Acronyme', {
            'label_attr': {
                'class': 'block text-sm font-medium text-gray-700 mb-1'
            }
        }) }}
	{{ form_widget(form.acronyme, {
            'attr': {
                'class': 'block w-full px-4 py-2 text-sm text-gray-700 bg-white border border-gray-200 rounded-md focus:border-indigo-500 focus:ring-indigo-500 uppercase',
                'placeholder': 'Ex: PMKT23',
                'maxlength': 6,
                'style': 'text-transform: uppercase'
            }
        }) }}
	<p class="mt-1 text-xs text-gray-500">
		Maximum 6 caractères (lettres majuscules et chiffres uniquement)
	</p>
	{{ form_errors(form.acronyme) }}
</div>

{# Champ Description #}
<div>
	{{ form_label(form.description, 'Description', {
            'label_attr': {
                'class': 'block text-sm font-medium text-gray-700 mb-1'
            }
        }) }}
	{{ form_widget(form.description, {
            'attr': {
                'class': 'block w-full px-4 py-2 text-sm text-gray-700 bg-white border border-gray-200 rounded-md focus:border-indigo-500 focus:ring-indigo-500',
                'placeholder': 'Description détaillée du projet...',
                'rows': 4
            }
        }) }}
	{{ form_errors(form.description) }}
</div>

{# Champ Statut #}
<div>
	{{ form_label(form.status, 'Statut', {
            'label_attr': {
                'class': 'block text-sm font-medium text-gray-700 mb-1'
            }
        }) }}
	{{ form_widget(form.status, {
            'attr': {
                'class': 'block w-full px-4 py-2 text-sm text-gray-700 bg-white border border-gray-200 rounded-md focus:border-indigo-500 focus:ring-indigo-500'
            }
        }) }}
	{{ form_errors(form.status) }}
</div>

{# Boutons d'action #}
<div class="flex justify-end space-x-3 pt-4 border-t border-gray-200">
	<button type="submit" class="inline-flex items-center px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
		<i class="fas fa-save mr-2"></i>
		{{ button_label|default('Enregistrer') }}
	</button>
</div>

{{ form_end(form) }}

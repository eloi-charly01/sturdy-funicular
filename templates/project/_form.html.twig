{% set field_classes = 'block w-full rounded-md border border-border bg-surface px-3.5 py-2 text-sm text-ink placeholder:text-ink-faint focus:outline-none focus:ring-2 focus:ring-focus-ring' %}
{% set label_classes = 'block text-sm font-medium text-ink mb-1.5' %}

{{ form_start(form, {'attr': {'class': 'space-y-6'}}) }}

<div>
	{{ form_label(form.name, 'Nom du projet', {'label_attr': {'class': label_classes}}) }}
	{{ form_widget(form.name, {'attr': {'class': field_classes, 'placeholder': 'Ex: Projet Marketing 2023'}}) }}
	{{ form_errors(form.name) }}
</div>

<div>
	{{ form_label(form.acronyme, 'Acronyme', {'label_attr': {'class': label_classes}}) }}
	{{ form_widget(form.acronyme, {'attr': {
		'class': field_classes ~ ' uppercase',
		'placeholder': 'Ex: PMKT23',
		'maxlength': 6,
	}}) }}
	<p class="mt-1 text-xs text-ink-muted">
		Maximum 6 caractères (lettres majuscules et chiffres uniquement)
	</p>
	{{ form_errors(form.acronyme) }}
</div>

<div>
	{{ form_label(form.description, 'Description', {'label_attr': {'class': label_classes}}) }}
	{{ form_widget(form.description, {'attr': {'class': field_classes, 'placeholder': 'Description détaillée du projet...', 'rows': 4}}) }}
	{{ form_errors(form.description) }}
</div>

<div>
	{{ form_label(form.status, 'Statut', {'label_attr': {'class': label_classes}}) }}
	{{ form_widget(form.status, {'attr': {'class': field_classes}}) }}
	{{ form_errors(form.status) }}
</div>

<div class="flex justify-end space-x-3 border-t border-border pt-4">
	{{ include('components/button.html.twig', {
		type: 'submit',
		icon: 'fas fa-save',
		label: button_label|default('Enregistrer'),
	}) }}
</div>

{{ form_end(form) }}
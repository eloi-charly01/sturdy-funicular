{% extends 'base.html.twig' %}

{% block title %}
	{{ parent() }}
	Modifier un Projet
{% endblock %}

{% block body %}
	<div class="overflow-hidden">
		<div class="mb-6 flex items-center justify-between">
			<div>
				<h4 class="text-2xl font-semibold text-ink">Modification du projet</h4>
				<p class="mt-1 text-sm text-ink-muted">Mettez à jour les informations du projet</p>
			</div>
			{{ include('components/button.html.twig', {
				href: path('app_project.index'),
				variant: 'secondary',
				icon: 'fas fa-arrow-left',
				label: 'Retour à la liste',
			}) }}
		</div>
		<div class="overflow-hidden rounded-lg border border-border bg-surface shadow-sm">
			{% set form_body %}
				{% include "project/_form.html.twig" with { button_label: 'Enregistrer' } %}
			{% endset %}
			{{ include('components/card.html.twig', { body: form_body }) }}
		</div>
	</div>
{% endblock %}
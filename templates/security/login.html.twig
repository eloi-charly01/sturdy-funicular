{% extends 'base_auth.html.twig' %}

{% block title %}Connexion - TaskManager{% endblock %}

{% block body %}
	<div class="flex min-h-screen items-center justify-center px-4 py-12 sm:px-6 lg:px-8">
		<div class="w-full max-w-md">
			<div class="mb-8 flex flex-col items-center">
				<span class="flex h-12 w-12 items-center justify-center rounded-md bg-brand-600 text-xl text-white">
					<i class="fas fa-tasks"></i>
				</span>
				<h1 class="mt-4 text-xl font-bold text-ink">TaskManager</h1>
				<p class="mt-1 text-sm text-ink-muted">Connectez-vous à votre espace de travail</p>
			</div>

			<div class="rounded-lg border border-border bg-surface px-6 py-8 shadow-sm sm:px-10">
				<form class="space-y-6" method="post">
					{% if error %}
						<div class="flex items-start rounded-md bg-danger/10 p-4">
							<div class="flex-shrink-0">
								<i class="fas fa-exclamation-circle text-danger"></i>
							</div>
							<div class="ml-3 text-sm text-danger">
								{{ error.messageKey|trans(error.messageData, 'security') }}
							</div>
						</div>
					{% endif %}

					<input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

					<div>
						{{ include('components/input.html.twig', {
							name: '_username',
							type: 'email',
							label: 'Email professionnel',
							icon: 'fas fa-envelope',
							placeholder: 'votre@email.com',
							value: last_username,
							required: true,
							autofocus: true,
							autocomplete: 'username',
						}) }}
					</div>

					<div>
						{{ include('components/input.html.twig', {
							name: '_password',
							type: 'password',
							label: 'Mot de passe',
							icon: 'fas fa-lock',
							placeholder: '••••••••',
							required: true,
							autocomplete: 'current-password',
						}) }}
					</div>

					<div class="flex items-center justify-between">
						<div class="flex items-center">
							<input id="remember_me" name="_remember_me" type="checkbox" class="h-4 w-4 rounded border-border bg-surface text-brand-600 focus:ring-2 focus:ring-focus-ring">
							<label for="remember_me" class="ml-2 block text-sm text-ink">
								Se souvenir de moi
							</label>
						</div>

						<div class="text-sm">
							<a href="{{ path('app_forgot_password_request') }}" class="font-medium text-brand-600 hover:text-brand-700">
								Mot de passe oublié ?
							</a>
						</div>
					</div>

					{{ include('components/button.html.twig', {
						type: 'submit',
						icon: 'fas fa-sign-in-alt',
						label: 'Se connecter',
						extra_classes: 'w-full justify-center',
					}) }}
				</form>
			</div>
		</div>
	</div>
{% endblock %}
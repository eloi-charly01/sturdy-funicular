<aside class="hidden w-64 flex-shrink-0 border-r border-border bg-surface md:block">
	<div class="flex h-full flex-col">
		{# Profil #}
		<div class="flex flex-col items-center space-y-2 border-b border-border px-4 py-6">
			<div class="relative">
				{% if app.user.photo %}
					<img class="h-20 w-20 rounded-full object-cover" src="{{ asset('uploads/users/' ~ app.user.photo) }}" alt="Photo de profil">
				{% else %}
					<div class="flex h-20 w-20 items-center justify-center rounded-full bg-brand-600 text-2xl font-bold text-white">
						{{ app.user.firstname|first|upper }}{{ app.user.lastname|first|upper }}
					</div>
				{% endif %}
			</div>
			<div class="text-center text-sm font-semibold text-ink">
				{{ app.user.firstname }}
				{{ app.user.lastname }}
			</div>
			<div class="text-center text-xs text-ink-muted">{{ app.user.email }}</div>
		</div>

		{# Menu principal #}
		<div class="flex flex-grow flex-col overflow-y-auto px-3 py-4">
			<nav class="flex-1 space-y-6">
				<div>
					<h3 class="px-3 text-xs font-semibold uppercase tracking-wider text-ink-faint">Menu Principal</h3>
					<div class="mt-2 space-y-1">
						<a href="{{ path('app_home') }}" class="flex items-center rounded-md px-3 py-2 text-sm font-medium {{ app.current_route == 'app_home' ? 'bg-brand-50 text-brand-700' : 'text-ink-muted hover:bg-surface-active hover:text-ink' }}">
							<i class="fas fa-home mr-3 w-4 text-center"></i>
							Tableau de bord
						</a>
						<a href="{{ path('app_project.index') }}" class="flex items-center rounded-md px-3 py-2 text-sm font-medium {{ app.current_route starts with 'app_project.' ? 'bg-brand-50 text-brand-700' : 'text-ink-muted hover:bg-surface-active hover:text-ink' }}">
							<i class="fas fa-folder-open mr-3 w-4 text-center"></i>
							Projets
						</a>
						<a href="{{ path('app_user.index') }}" class="flex items-center rounded-md px-3 py-2 text-sm font-medium {{ app.current_route starts with 'app_user.' ? 'bg-brand-50 text-brand-700' : 'text-ink-muted hover:bg-surface-active hover:text-ink' }}">
							<i class="fas fa-users mr-3 w-4 text-center"></i>
							Membres
						</a>
						<a href="{{ path('app_task.index') }}" class="flex items-center rounded-md px-3 py-2 text-sm font-medium {{ app.current_route starts with 'app_task.' ? 'bg-brand-50 text-brand-700' : 'text-ink-muted hover:bg-surface-active hover:text-ink' }}">
							<i class="fas fa-check-square mr-3 w-4 text-center"></i>
							Taches
						</a>
					</div>
				</div>

				<div>
					<h3 class="px-3 text-xs font-semibold uppercase tracking-wider text-ink-faint">Autres</h3>
					<div class="mt-2 space-y-1">
						<a href="#" class="flex items-center rounded-md px-3 py-2 text-sm font-medium text-ink-muted hover:bg-surface-active hover:text-ink">
							<i class="fas fa-cog mr-3 w-4 text-center"></i>
							Paramètres
						</a>
						<a href="#" class="flex items-center rounded-md px-3 py-2 text-sm font-medium text-ink-muted hover:bg-surface-active hover:text-ink">
							<i class="fas fa-question-circle mr-3 w-4 text-center"></i>
							Aide
						</a>
					</div>
				</div>
			</nav>
		</div>
	</div>
</aside>
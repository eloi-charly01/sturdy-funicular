{% extends 'base_auth.html.twig' %}

{% block title %}Nouveau mot de passe - TaskManager{% endblock %}

{% block body %}
	<div class="flex min-h-screen items-center justify-center px-4 py-12 sm:px-6 lg:px-8">
		<div class="w-full max-w-md">
			<div class="mb-8 flex flex-col items-center">
				<span class="flex h-12 w-12 items-center justify-center rounded-md bg-brand-600 text-xl text-white">
					<i class="fas fa-lock"></i>
				</span>
				<h1 class="mt-4 text-xl font-bold text-ink">Choisissez un nouveau mot de passe</h1>
			</div>

			<div class="rounded-lg border border-border bg-surface px-6 py-8 shadow-sm sm:px-10">
				{{ form_start(resetForm, {'attr': {'class': 'space-y-5'}}) }}
				<div>
					{{ form_label(resetForm.plainPassword, 'Nouveau mot de passe', { label_attr: { class: 'mb-1.5 block text-sm font-medium text-ink' } }) }}
					{{ form_widget(resetForm.plainPassword, { attr: { class: 'block w-full rounded-md border border-border bg-surface px-3.5 py-2 text-sm text-ink placeholder:text-ink-faint focus:outline-none focus:ring-2 focus:ring-focus-ring' } }) }}
					{{ form_errors(resetForm.plainPassword) }}
				</div>

				{{ include('components/button.html.twig', {
					type: 'submit',
					icon: 'fas fa-check',
					label: 'Réinitialiser',
					extra_classes: 'w-full justify-center',
				}) }}
				{{ form_end(resetForm) }}

				<div class="mt-4 text-center">
					<a href="{{ path('app_login') }}" class="text-sm font-medium text-brand-600 hover:text-brand-700">
						Retour à la connexion
					</a>
				</div>
			</div>
		</div>
	</div>
{% endblock %}
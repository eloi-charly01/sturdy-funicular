{% extends 'base_auth.html.twig' %}

{% block title %}Mot de passe oublié - Task M{% endblock %}

{% block body %}
	<div class="min-h-screen flex flex-col justify-center py-12 px-4 sm:px-6 lg:px-8">
		<div class="sm:mx-auto sm:w-full sm:max-w-md">
			<div class="bg-white py-8 px-6 shadow rounded-lg sm:px-10 space-y-6">
				<div class="flex justify-center">
					<div class="w-16 h-16 rounded-full bg-indigo-600 flex items-center justify-center text-white text-2xl">
						<i class="fas fa-key"></i>
					</div>
				</div>

				<h1 class="text-center text-lg font-semibold text-gray-800">Mot de passe oublié</h1>

				{% for flash_error in app.flashes('reset_password_error') %}
					<div class="rounded-md bg-red-50 p-4 text-sm text-red-700">{{ flash_error }}</div>
				{% endfor %}

				{{ form_start(requestForm) }}
				<div>
					{{ form_label(requestForm.email, 'Email professionnel', { label_attr: { class: 'block text-sm font-medium text-gray-700' } }) }}
					{{ form_widget(requestForm.email, { attr: { class: 'mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm', placeholder: 'votre@email.com' } }) }}
					{{ form_errors(requestForm.email) }}
					<p class="mt-2 text-xs text-gray-500">
						Saisissez votre adresse email, nous vous enverrons un lien de réinitialisation.
					</p>
				</div>

				<button type="submit" class="mt-4 w-full flex justify-center items-center py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
					<i class="fas fa-paper-plane mr-2"></i>
					Envoyer le lien
				</button>
				{{ form_end(requestForm) }}

				<div class="text-center">
					<a href="{{ path('app_login') }}" class="text-sm font-medium text-indigo-600 hover:text-indigo-500">
						Retour à la connexion
					</a>
				</div>
			</div>
		</div>
	</div>
{% endblock %}

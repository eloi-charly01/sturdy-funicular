{% extends 'base_auth.html.twig' %}

{% block title %}Mot de passe oublié - TaskManager{% endblock %}

{% block body %}
	<div class="flex min-h-screen items-center justify-center px-4 py-12 sm:px-6 lg:px-8">
		<div class="w-full max-w-md">
			<div class="mb-8 flex flex-col items-center">
				<span class="flex h-12 w-12 items-center justify-center rounded-md bg-brand-600 text-xl text-white">
					<i class="fas fa-key"></i>
				</span>
				<h1 class="mt-4 text-xl font-bold text-ink">Mot de passe oublié</h1>
				<p class="mt-1 text-sm text-ink-muted">Saisissez votre email pour recevoir un lien</p>
			</div>

			<div class="rounded-lg border border-border bg-surface px-6 py-8 shadow-sm sm:px-10">
				{% for flash_error in app.flashes('reset_password_error') %}
					<div class="mb-4 flex items-start rounded-md bg-danger/10 p-4 text-sm text-danger">{{ flash_error }}</div>
				{% endfor %}

				{{ form_start(requestForm, {'attr': {'class': 'space-y-5'}}) }}
				<div>
					{{ form_label(requestForm.email, 'Email professionnel', { label_attr: { class: 'mb-1.5 block text-sm font-medium text-ink' } }) }}
					{{ form_widget(requestForm.email, { attr: { class: 'block w-full rounded-md border border-border bg-surface px-3.5 py-2 text-sm text-ink placeholder:text-ink-faint focus:outline-none focus:ring-2 focus:ring-focus-ring', placeholder: 'votre@email.com' } }) }}
					{{ form_errors(requestForm.email) }}
					<p class="mt-2 text-xs text-ink-muted">
						Un lien de réinitialisation vous sera envoyé par email.
					</p>
				</div>

				{{ include('components/button.html.twig', {
					type: 'submit',
					icon: 'fas fa-paper-plane',
					label: 'Envoyer le lien',
					extra_classes: 'w-full justify-center',
				}) }}
				{{ form_end(requestForm) }}

				<div class="mt-4 text-center">
					<a href="{{ path('app_login') }}" class="text-sm font-medium text-brand-600 hover:text-brand-700">
						Retour à la connexion
					</a>
				</div>
			</div>
		</div>
	</div>
{% endblock %}